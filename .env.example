# Salin file ini ke .env (lokal) atau isi langsung di Railway > Variables.
BOT_TOKEN=          # token dari @BotFather, contoh 123456:AAF...
ADMIN_ID=           # Telegram user ID admin (dapat dari @userinfobot)
ADMIN_PASSWORD=     # password login web admin controller
GEMINI_API_KEY=     # API key Google AI Studio (format AIza...) untuk verifikasi screenshot & generator fitur
NETLIFY_TOKEN=      # personal access token Netlify untuk deploy website
WA_CHANNEL_LINK=    # link saluran WhatsApp wajib follow
BOT_AUTOSTART=true  # bot langsung jalan saat service dinyalakan
